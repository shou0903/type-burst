{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "type-burst-web.vercel.app"
        }
      ],
      "destination": "https://type-burst.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.type-burst.com"
        }
      ],
      "destination": "https://type-burst.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guides/index.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/tools/index.html",
      "destination": "/tools",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/api/share-page?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
